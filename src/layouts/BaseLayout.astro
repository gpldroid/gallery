---
import '../styles/global.css';
const { title = 'Trendora — Timeless elegance, modern you', description = 'Discover a curated collection of rare and elegant pieces.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4ede4" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <script>
      import { gsap } from 'gsap';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
        intro.from('.announcement', { y: -18, opacity: 0, duration: .55 })
          .from('.site-header', { y: -14, opacity: 0, duration: .65 }, '-=.28')
          .from('.hero-copy > *', { y: 24, opacity: 0, stagger: .11, duration: .75 }, '-=.18')
          .from('.hero-visual', { clipPath: 'inset(0 0 0 18%)', opacity: 0, duration: 1.1 }, '-=.72')
          .from('.trust-item', { y: 12, opacity: 0, stagger: .08, duration: .45 }, '-=.45');
        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((element) => {
          gsap.from(element, {
            y: 28, opacity: 0, duration: .8, ease: 'power2.out',
            scrollTrigger: undefined,
            delay: 0,
            onComplete: () => element.classList.add('is-visible'),
          });
        });
      }

      const hero = document.querySelector<HTMLElement>('.hero-visual');
      if (hero && !reduceMotion && window.matchMedia('(pointer:fine)').matches) {
        hero.addEventListener('pointermove', (event) => {
          const rect = hero.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - .5;
          const y = (event.clientY - rect.top) / rect.height - .5;
          gsap.to(hero.querySelector('.hero-photo'), {
            x: x * -9, y: y * -7, duration: .7, ease: 'power2.out',
          });
        });
        hero.addEventListener('pointerleave', () => {
          gsap.to(hero.querySelector('.hero-photo'), { x: 0, y: 0, duration: .8, ease: 'power3.out' });
        });
      }

      const searchToggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
      const searchPanel = document.querySelector<HTMLElement>('.search-panel');
      searchToggle?.addEventListener('click', () => {
        const open = searchToggle.getAttribute('aria-expanded') === 'true';
        searchToggle.setAttribute('aria-expanded', String(!open));
        searchPanel?.classList.toggle('search-panel--open', !open);
        if (!open) searchPanel?.querySelector('input')?.focus();
      });

      const wishlist = document.querySelector<HTMLButtonElement>('[data-wishlist]');
      wishlist?.addEventListener('click', () => {
        const active = wishlist.getAttribute('aria-pressed') === 'true';
        wishlist.setAttribute('aria-pressed', String(!active));
        wishlist.classList.toggle('is-active', !active);
        wishlist.setAttribute('aria-label', active ? 'Add to wishlist' : 'Remove from wishlist');
      });

      const bag = document.querySelector<HTMLButtonElement>('[data-bag]');
      bag?.addEventListener('click', () => {
        const count = bag.querySelector('[data-bag-count]');
        if (count) count.textContent = '0';
        bag.setAttribute('aria-label', 'Shopping bag, empty');
      });

      const newsletter = document.querySelector<HTMLFormElement>('[data-newsletter]');
      newsletter?.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = newsletter.querySelector<HTMLInputElement>('input[type="email"]');
        const message = newsletter.querySelector<HTMLElement>('[data-newsletter-message]');
        if (!input?.checkValidity()) { input?.reportValidity(); return; }
        if (message) message.textContent = 'Thank you — you’re on the list.';
        newsletter.reset();
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.querySelector(link.getAttribute('href') || '');
          if (target) {
            event.preventDefault();
            target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          }
        });
      });
    </script>
  </body>
</html>