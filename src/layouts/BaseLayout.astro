---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const base = import.meta.env.BASE_URL;
const { title = 'Margins — Stories, books & the spaces between', description = 'A quiet corner of the internet for stories, books, and thoughtful reading.', current = 'home', image = 'https://images.unsplash.com/photo-1519682337058-a94d519337bc?auto=format&fit=crop&w=1200&q=85' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee5" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader current={current} />
    <slot />
    <SiteFooter />
    <div class="reading-controls" aria-label="Page navigation">
      <button type="button" data-scroll-top aria-label="Scroll to top" title="Scroll to top"><span aria-hidden="true">↑</span></button>
      <button type="button" data-scroll-down aria-label="Scroll down" title="Scroll down"><span aria-hidden="true">↓</span></button>
    </div>
    <script>
      import { gsap } from 'gsap';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        const introTargets = document.querySelectorAll('[data-intro]');
        if (introTargets.length) gsap.from(introTargets, { y: 22, autoAlpha: 0, duration: .85, stagger: .1, ease: 'power3.out', delay: .12 });
        const observer = new IntersectionObserver((entries, io) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            gsap.fromTo(entry.target, { y: 24, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .72, ease: 'power2.out' });
            io.unobserve(entry.target);
          });
        }, { threshold: .1 });
        document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
        const visual = document.querySelector<HTMLElement>('[data-depth]');
        if (visual && window.matchMedia('(pointer:fine)').matches) {
          visual.addEventListener('pointermove', (event) => {
            const rect = visual.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - .5;
            const y = (event.clientY - rect.top) / rect.height - .5;
            gsap.to(visual.querySelector('[data-depth-image]'), { x: x * -8, y: y * -6, duration: .7, ease: 'power2.out' });
          });
          visual.addEventListener('pointerleave', () => gsap.to(visual.querySelector('[data-depth-image]'), { x: 0, y: 0, duration: .8, ease: 'power3.out' }));
        }
      }

      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const storedTheme = localStorage.getItem('margins-theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const applyTheme = (theme: 'light' | 'dark') => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        themeButton?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#171d19' : '#f3eee5');
      };
      applyTheme(storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : (systemDark ? 'dark' : 'light'));
      themeButton?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        localStorage.setItem('margins-theme', next);
      });
      document.querySelector('[data-scroll-top]')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' }));
      document.querySelector('[data-scroll-down]')?.addEventListener('click', () => window.scrollBy({ top: Math.max(window.innerHeight * .78, 360), behavior: reduceMotion ? 'auto' : 'smooth' }));
      const scrollControls = document.querySelector<HTMLElement>('.reading-controls');
      const updateScrollControls = () => scrollControls?.classList.toggle('reading-controls--visible', window.scrollY > 280);
      updateScrollControls();
      window.addEventListener('scroll', updateScrollControls, { passive: true });
      if (!reduceMotion && window.matchMedia('(pointer:fine)').matches) {
        document.querySelectorAll<HTMLElement>('.story-card, .book-card, .featured-story-image, .button, .social-links a').forEach((card) => {
          card.addEventListener('pointermove', (event) => {
            const rect = card.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - .5;
            const y = (event.clientY - rect.top) / rect.height - .5;
            card.style.setProperty('--tilt-x', String((-y * 5).toFixed(2)) + 'deg');
            card.style.setProperty('--tilt-y', String((x * 6).toFixed(2)) + 'deg');
          });
          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--tilt-x', '0deg');
            card.style.setProperty('--tilt-y', '0deg');
          });
        });
      }
    </script>
  </body>
</html>