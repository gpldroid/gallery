---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}
const base = import.meta.env.BASE_URL;
const { book } = Astro.props;
const { Content } = await render(book);
const related = (await getCollection('books')).filter((item) => item.id !== book.id).slice(0,2);
---
<BaseLayout title={`${book.data.title} by ${book.data.author} — Margins Library`} description={book.data.description} current="books" image={book.data.cover}>
  <main id="main-content" class="book-detail-page">
    <div class="book-detail-top section-shell"><a class="back-link" href={`${base}books/`}><ArrowLeft size={15} /> Back to the library</a></div>
    <section class="book-detail section-shell"><div class="book-detail-cover" data-reveal><div class="book-cover-frame book-cover-frame--large"><img src={book.data.cover} alt={book.data.coverAlt} /></div></div><div class="book-detail-copy" data-reveal><span class="eyebrow">{book.data.genre.toUpperCase()} <i>·</i> {book.data.year}</span><h1>{book.data.title}</h1>{book.data.subtitle && <p class="book-subtitle">{book.data.subtitle}</p>}<p class="book-author">by <strong>{book.data.author}</strong></p><p class="book-description">{book.data.description}</p><div class="book-facts"><span><small>GENRE</small><strong>{book.data.genre}</strong></span><span><small>PAGES</small><strong>{book.data.pages}</strong></span><span><small>FIRST PUBLISHED</small><strong>{book.data.year}</strong></span></div><a class="button button--ink" href="#reading-note">Read the introduction <ArrowUpRight size={16} /></a></div></section>
    <section class="book-reading section-shell" id="reading-note"><div class="book-reading-heading"><span class="eyebrow">BETWEEN THE COVERS</span><h2>A little about<br /><em>this book.</em></h2></div><article class="prose book-prose"><Content /></article></section>
    {related.length > 0 && <section class="related-books section-shell"><div class="section-heading"><div><span class="eyebrow">ANOTHER WORLD AWAITS</span><h2>You may also enjoy<span>.</span></h2></div><a class="text-link" href={`${base}books/`}>All books <ArrowUpRight size={15} /></a></div><div class="related-list">{related.map((item) => <a class="related-book" href={`${base}books/${item.id}/`}><img src={item.data.cover} alt={item.data.coverAlt} /><span><strong>{item.data.title}</strong><small>{item.data.author}</small></span><ArrowUpRight size={16} /></a>)}</div></section>}
  </main>
</BaseLayout>