---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Search, Heart, ShoppingBag, Gem, Truck, ShieldCheck, Headset, ArrowUpRight } from '@lucide/astro';
---
<BaseLayout>
  <div class="announcement">
    <span class="announcement__spark">✦</span>
    <span>Complimentary shipping on orders over $100</span>
    <span class="announcement__spark">✦</span>
  </div>

  <header class="site-header">
    <a class="brand" href="#home" aria-label="Trendora home">
      <span class="brand__mark" aria-hidden="true">✧</span>
      <span>Trendora</span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="#collections">Shop</a>
      <a href="#collections">Collections</a>
      <a href="#contact">About</a>
      <a href="#collections">Journal</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="header-actions">
      <button class="icon-button" data-search-toggle aria-label="Open search" aria-expanded="false">
        <Search size={20} stroke-width={1.6} aria-hidden="true" />
      </button>
      <button class="icon-button" data-wishlist aria-label="Add to wishlist" aria-pressed="false">
        <Heart size={20} strokeWidth={1.6} aria-hidden="true" />
      </button>
      <button class="icon-button bag-button" data-bag aria-label="Shopping bag, 0 items">
        <ShoppingBag size={20} strokeWidth={1.6} aria-hidden="true" />
        <span class="bag-count" data-bag-count>0</span>
      </button>
    </div>
    <div class="search-panel">
      <label for="site-search">Search the collection</label>
      <input id="site-search" type="search" placeholder="Try handbags, jewelry..." />
    </div>
  </header>

  <main id="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-backdrop"></div>
      <div class="hero-copy">
        <span class="eyebrow">THE ART OF EVERYDAY LUXURY</span>
        <h1 id="hero-title">Timeless Elegance,<br /><em>Modern You</em></h1>
        <p>Discover our exclusive collection<br class="desktop-break" /> of rare and elegant pieces.</p>
        <a class="button button--dark" href="#collections">Explore the collection <span>↗</span></a>
        <div class="hero-index"><span>01</span><i></i><span>04</span></div>
      </div>
      <div class="hero-visual">
        <img class="hero-photo" src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1400&q=90" alt="Editorial fashion portrait in an elegant dark outfit" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="floating-product">
          <span class="floating-product__caption">THE ICON EDIT</span>
          <img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=500&q=85" alt="Structured beige leather handbag" />
          <span class="floating-product__name">The Élise bag</span>
        </div>
        <span class="hero-side-note">A STUDY IN SOPHISTICATION · EST. 2024</span>
        <a class="hero-next" href="#collections" aria-label="Discover collections"><ArrowUpRight size={20} /></a>
      </div>
      <div class="hero-bottom-note">CURATED WITH INTENTION <span>—</span> WORN WITH CONFIDENCE</div>
    </section>

    <section class="trust-strip" aria-label="Our promises">
      <div class="trust-item"><Gem class="trust-icon" size={27} stroke-width={1.4} aria-hidden="true" /><span><strong>Exclusive Pieces</strong><small>Only Here</small></span></div>
      <div class="trust-item"><Truck class="trust-icon" size={27} strokeWidth={1.4} aria-hidden="true" /><span><strong>Fast &amp; Secure Delivery</strong><small>Across Morocco</small></span></div>
      <div class="trust-item"><ShieldCheck class="trust-icon" size={27} strokeWidth={1.4} aria-hidden="true" /><span><strong>Secure Payments</strong><small>100% Safe</small></span></div>
      <div class="trust-item"><Headset class="trust-icon" size={27} strokeWidth={1.4} aria-hidden="true" /><span><strong>Dedicated Support</strong><small>24/7</small></span></div>
    </section>

    <section class="collections section-wrap" id="collections">
      <div class="section-heading" data-reveal>
        <div><span class="eyebrow">A WORLD OF BEAUTIFUL DETAILS</span><h2>Explore Our World<span>.</span></h2></div>
        <a class="text-link" href="#newsletter">View the edit <span>↗</span></a>
      </div>
      <div class="category-grid">
        <a class="category-card" href="#newsletter" data-reveal>
          <img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=850&q=85" alt="Timeless beige leather handbag" loading="lazy" />
          <span class="category-card__number">01 / ACCESSORIES</span>
          <span class="category-card__bottom"><strong>Handbags</strong><small>Discover edit <b>↗</b></small></span>
        </a>
        <a class="category-card" href="#newsletter" data-reveal>
          <img src="https://images.unsplash.com/photo-1524592094714-0f0654e20314?auto=format&fit=crop&w=850&q=85" alt="Elegant wristwatch with dark dial" loading="lazy" />
          <span class="category-card__number">02 / TIMEPIECES</span>
          <span class="category-card__bottom"><strong>Watches</strong><small>Discover edit <b>↗</b></small></span>
        </a>
        <a class="category-card" href="#newsletter" data-reveal>
          <img src="https://images.unsplash.com/photo-1611652022419-a9419f74343d?auto=format&fit=crop&w=850&q=85" alt="Delicate gold jewelry" loading="lazy" />
          <span class="category-card__number">03 / OBJECTS OF DESIRE</span>
          <span class="category-card__bottom"><strong>Jewelry</strong><small>Discover edit <b>↗</b></small></span>
        </a>
        <a class="category-card" href="#newsletter" data-reveal>
          <img src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=850&q=85" alt="Classic pointed-toe heels" loading="lazy" />
          <span class="category-card__number">04 / THE FINISHING TOUCH</span>
          <span class="category-card__bottom"><strong>Shoes</strong><small>Discover edit <b>↗</b></small></span>
        </a>
      </div>
    </section>

    <section class="newsletter section-wrap" id="newsletter" data-reveal>
      <div class="newsletter-copy">
        <span class="eyebrow">A LITTLE SOMETHING, JUST FOR YOU</span>
        <h2>10% off, <em>on us.</em></h2>
        <p>Be the first to discover new arrivals, considered edits<br class="desktop-break" /> and a welcome gift for your first order.</p>
        <form class="newsletter-form" data-newsletter>
          <label class="sr-only" for="newsletter-email">Your email address</label>
          <input id="newsletter-email" type="email" placeholder="Your email address" required />
          <button type="submit">Join the list <span>↗</span></button>
          <p class="newsletter-message" data-newsletter-message aria-live="polite"></p>
        </form>
        <small class="privacy-note">By subscribing, you agree to receive occasional notes from Trendora.</small>
      </div>
      <div class="newsletter-art">
        <img src="https://images.unsplash.com/photo-1513883049090-d0b7439799bf?auto=format&fit=crop&w=900&q=85" alt="Thoughtfully wrapped luxury gift with ribbon" loading="lazy" />
        <span class="newsletter-art__seal">A GIFT<br />FROM US</span>
      </div>
    </section>
  </main>

  <footer class="site-footer" id="contact">
    <div class="footer-main">
      <a class="brand brand--footer" href="#home"><span class="brand__mark">✧</span><span>Trendora</span></a>
      <p>More than fashion.<br />A feeling, thoughtfully found.</p>
      <div class="footer-links"><a href="#collections">Shop</a><a href="#about">About</a><a href="#journal">Journal</a><a href="#contact">Contact</a></div>
      <div class="social-links" aria-label="Social links">
        <a href="https://instagram.com" aria-label="Instagram">ig</a><a href="https://pinterest.com" aria-label="Pinterest">p</a><a href="https://tiktok.com" aria-label="TikTok">tk</a>
      </div>
    </div>
    <div class="footer-bottom"><span>© 2026 Trendora. All rights reserved.</span><span>Made for the beautifully discerning.</span><span>Privacy · Terms</span></div>
  </footer>
</BaseLayout>