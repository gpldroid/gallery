---
import { ArrowLeft, BookOpen } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Margins" description="This page seems to have slipped between the pages.">
  <main id="main-content" class="not-found"><span class="eyebrow">A PAGE OUT OF PLACE</span><div class="not-found-icon"><BookOpen size={42} strokeWidth={1} /></div><h1>This page has<br /><em>turned a corner.</em></h1><p>We couldn't find the page you were looking for. Perhaps the next story is waiting elsewhere.</p><a class="button button--ink" href="/"><ArrowLeft size={15} /> Return home</a></main>
</BaseLayout>