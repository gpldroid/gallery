---
const base = import.meta.env.BASE_URL;
import { ArrowUpRight, Feather } from '@lucide/astro';
---
<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand-block">
      <a class="brand brand--footer" href={base}><span class="brand-symbol"><Feather size={22} stroke-width={1.4} /></span><span class="brand-word">margins<span>.</span></span></a>
      <p>A quiet corner of the internet<br />for stories that stay with you.</p>
    </div>
    <div class="footer-column"><span class="footer-label">EXPLORE</span><a href={`${base}stories/`}>Stories</a><a href={`${base}books/`}>The library</a><a href={`${base}about/`}>Our little world</a></div>
    <div class="footer-column footer-social"><span class="footer-label">FOLLOW THE WORDS</span><div class="social-links"><a class="social-instagram" href="https://www.instagram.com/" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="url(#instagram-gradient)" stroke-width="1.9"><defs><linearGradient id="instagram-gradient" x1="2" y1="22" x2="22" y2="2" gradientUnits="userSpaceOnUse"><stop stop-color="#FFDC80"/><stop offset=".35" stop-color="#F77737"/><stop offset=".68" stop-color="#E1306C"/><stop offset="1" stop-color="#833AB4"/></linearGradient></defs><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="#E1306C" stroke="none"/></svg></a><a class="social-facebook" href="https://www.facebook.com/" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" fill="#1877F2"><path d="M13.4 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.2V13H10v8h3.4Z" /></svg></a><a class="social-youtube" href="https://www.youtube.com/" aria-label="YouTube" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" fill="#FF0033"><path d="M23 7.1a3 3 0 0 0-2.1-2.2C19 4.4 12 4.4 12 4.4s-7 0-8.9.5A3 3 0 0 0 1 7.1 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.9 3 3 0 0 0 2.1 2.2c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.2 31 31 0 0 0 .5-4.9 31 31 0 0 0-.5-4.9ZM9.7 15.5v-7l6 3.5-6 3.5Z" /></svg></a></div></div>
    <div class="footer-column"><span class="footer-label">THE READING ROOM</span><p>Take your time.<br />Turn another page.</p><a class="footer-top-link" href="#top">Back to the beginning <ArrowUpRight size={14} /></a></div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Margins Journal</span><span>Made for the love of words.</span><span>Read slowly. Feel deeply.</span></div>
</footer>