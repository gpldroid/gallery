---
const base = import.meta.env.BASE_URL;
import { ArrowUpRight, Feather, Instagram, Facebook, Youtube } from '@lucide/astro';
---
<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand-block">
      <a class="brand brand--footer" href={base}><span class="brand-symbol"><Feather size={22} stroke-width={1.4} /></span><span class="brand-word">margins<span>.</span></span></a>
      <p>A quiet corner of the internet<br />for stories that stay with you.</p>
    </div>
    <div class="footer-column"><span class="footer-label">EXPLORE</span><a href={`${base}stories/`}>Stories</a><a href={`${base}books/`}>The library</a><a href={`${base}about/`}>Our little world</a></div>
    <div class="footer-column footer-social"><span class="footer-label">FOLLOW THE WORDS</span><div class="social-links"><a href="https://www.instagram.com/" aria-label="Instagram"><Instagram size={17} /></a><a href="https://www.facebook.com/" aria-label="Facebook"><Facebook size={17} /></a><a href="https://www.youtube.com/" aria-label="YouTube"><Youtube size={17} /></a></div></div>
    <div class="footer-column"><span class="footer-label">THE READING ROOM</span><p>Take your time.<br />Turn another page.</p><a class="footer-top-link" href="#top">Back to the beginning <ArrowUpRight size={14} /></a></div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Margins Journal</span><span>Made for the love of words.</span><span>Read slowly. Feel deeply.</span></div>
</footer>