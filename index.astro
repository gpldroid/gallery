---
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight, Feather, Library } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import BookCard from '../components/BookCard.astro';
const stories = (await getCollection('stories')).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const books = await getCollection('books');
const featuredStory = stories.find((story) => story.data.featured) ?? stories[0];
const recentStories = stories.filter((story) => story.id !== featuredStory?.id).slice(0, 3);
const featuredBooks = books.filter((book) => book.data.featured).slice(0, 3);
---
<BaseLayout title="Margins — Stories worth staying for" description="A literary journal and reading room for curious minds." current="home">
  <main id="main-content">
    <section class="home-hero">
      <div class="home-hero-copy">
        <span class="eyebrow" data-intro>AN INDEPENDENT LITERARY JOURNAL</span>
        <h1 data-intro>Stories worth<br /><em>staying for.</em></h1>
        <p data-intro>For the curious, the daydreamers, and everyone who has ever lost track of time inside a good story.</p>
        <div class="hero-actions" data-intro><a class="button button--ink" href="/stories/">Wander through stories <ArrowUpRight size={16} /></a><a class="quiet-link" href="/books/">Explore the library <ArrowRight size={15} /></a></div>
        <span class="hero-footnote" data-intro><Feather size={14} /> A little more wonder in every day.</span>
      </div>
      <div class="home-hero-art" data-depth>
        <img data-depth-image src="https://images.unsplash.com/photo-1519682337058-a94d519337bc?auto=format&fit=crop&w=1500&q=90" alt="A quiet reading scene with an open book and soft afternoon light" fetchpriority="high" />
        <div class="hero-art-caption"><span>THE READING ROOM</span><span>VOL. 01 — OPEN A PAGE</span></div>
        <div class="hero-art-stamp">READ<br />SLOWLY</div>
      </div>
      <div class="hero-vertical-note">FICTION · REFLECTION · DISCOVERY</div>
    </section>
    <section class="intro-ribbon"><span>WORDS TO GET LOST IN</span><i></i><span>IDEAS TO TAKE WITH YOU</span><i></i><span>PLACES TO RETURN TO</span></section>
    {featuredStory && <section class="featured-story section-shell">
      <div class="section-kicker" data-reveal><span class="eyebrow">THE EDITOR'S PICK</span><span class="section-index">A STORY TO BEGIN WITH</span></div>
      <div class="featured-story-layout">
        <a class="featured-story-image" href={`/stories/${featuredStory.id}/`} data-reveal><img src={featuredStory.data.cover} alt={featuredStory.data.coverAlt} loading="lazy" /><span class="image-corner-note">A MOMENT IN WORDS</span></a>
        <div class="featured-story-copy" data-reveal>
          <span class="story-category">{featuredStory.data.category} <i>·</i> {featuredStory.data.readingTime} MIN READ</span>
          <h2>{featuredStory.data.title}</h2><p class="featured-excerpt">{featuredStory.data.excerpt}</p>
          <p class="featured-byline">A story by <strong>{featuredStory.data.author}</strong></p>
          <a class="button button--outline" href={`/stories/${featuredStory.id}/`}>Step inside <ArrowUpRight size={16} /></a>
        </div>
      </div>
    </section>}
    <section class="recent-section"><div class="section-shell">
      <div class="section-heading" data-reveal><div><span class="eyebrow">FRESH IN THE JOURNAL</span><h2>Recently written<span>.</span></h2></div><a class="text-link" href="/stories/">All stories <ArrowUpRight size={15} /></a></div>
      <div class="story-grid">{recentStories.map((story) => <StoryCard story={story} />)}</div>
      {recentStories.length === 0 && <p class="empty-note">New stories are finding their way here. Come back soon.</p>}
    </div></section>
    <section class="library-teaser section-shell">
      <div class="library-teaser-head" data-reveal><div><span class="eyebrow">A SHELF OF POSSIBILITIES</span><h2>Books to keep<br /><em>close by.</em></h2><p>Some books entertain. Others quietly rearrange the furniture of your mind.</p><a class="button button--paper" href="/books/">Visit the library <ArrowUpRight size={16} /></a></div><div class="library-ornament"><Library size={76} stroke-width={.8} /><span>TAKE<br />A BOOK</span></div></div>
      <div class="book-shelf">{featuredBooks.map((book) => <BookCard book={book} />)}</div>
    </section>
    <section class="closing-note"><span class="closing-asterisk">✳</span><p>“There is no friend as loyal as a book.”</p><span class="closing-attribution">— ERNEST HEMINGWAY</span></section>
  </main>
</BaseLayout>
